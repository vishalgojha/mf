# --- Frontend ---------------------------------------------------------------
# Free MFAPI.in base URL (must end with a slash)
# Search: {base}search?q=axis  |  Fund NAV: {base}120716
VITE_MFAPI_URL=https://api.mfapi.in/mf/

# --- Instinct API (server only) ---------------------------------------------
# Defaults to 8080 locally; Coolify maps this port to the public domain.
PORT=8080

# Optional. If set, POST /api/instinct/ask requires "Authorization: Bearer ...".
# Deterministic tool endpoints stay public but rate-limited.
# INSTINCT_API_KEY=

# Comma-separated provider order. Unconfigured providers are skipped.
INSTINCT_PROVIDERS=nvidia,openrouter

# Free NVIDIA NIM key: https://build.nvidia.com/
# NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Free OpenRouter key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional tuning
# INSTINCT_MAX_STEPS=6
# INSTINCT_MAX_TOKENS=900
# INSTINCT_TIMEOUT_MS=45000
# INSTINCT_TEMPERATURE=0.2
# INSTINCT_ASK_RATE_LIMIT=10
# INSTINCT_TOOL_RATE_LIMIT=120
# INSTINCT_ALLOWED_ORIGINS=*
# INSTINCT_TRUST_PROXY=1
# INSTINCT_PUBLIC_URL=https://mf.vishalojha.me
